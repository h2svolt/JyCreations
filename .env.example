# Copy this file to .env (which is gitignored) and fill in real values.
# The same three variables must also be added in Vercel → Project Settings →
# Environment Variables for production.

# Supabase project URL (Project Settings → API → Project URL)
SUPABASE_URL=

# Supabase service_role key (Project Settings → API → service_role, secret).
# Server-only — never expose this to the browser. Bypasses all database
# security, so treat it like a password.
SUPABASE_SERVICE_ROLE_KEY=

# Password required to log into /admin. Pick your own — unrelated to your
# Supabase account password.
ADMIN_PASSWORD=

# Random string used to sign the admin login session cookie. Generate one
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
